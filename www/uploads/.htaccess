# Médias envoyés par le gérant : jamais exécutés, jamais listés (FR-007 @security).
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht
RemoveType .php .phtml .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; sandbox"
</IfModule>
