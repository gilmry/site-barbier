  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AdminSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "none",
              "pre_enrolment",
              "password_ok",
              "full",
              "recovery"
            ]
          },
          "email": {
            "type": "string"
          },
          "csrf": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recentTotp": {
            "type": "boolean"
          },
          "recoveryCodesRemaining": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 190
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "CodeInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 6,
            "maxLength": 20
          }
        }
      },
      "TotpEnrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secret",
          "uri"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "pattern": "^[A-Z2-7]+$"
          },
          "uri": {
            "type": "string",
            "pattern": "^otpauth://totp/"
          }
        }
      },
      "RecoveryCodeList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codes"
        ],
        "properties": {
          "codes": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[2-9A-HJ-NP-Z]{5}-[2-9A-HJ-NP-Z]{5}$"
            }
          }
        }
      },
      "Translated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fr"
        ],
        "properties": {
          "fr": {
            "type": "string",
            "maxLength": 8000
          },
          "nl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000
          },
          "en": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000
          }
        }
      },
      "TranslatedOptional": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fr": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000
          },
          "nl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000
          },
          "en": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000
          }
        }
      },
      "Uuid": {
        "type": "string",
