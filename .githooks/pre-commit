#!/usr/bin/env bash
# Pré-commit (DRY avec la CI) : secrets, invariants structurels, tests rapides. Installé par ./go.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
docker run --rm -v "$ROOT":/repo -w /repo zricethezav/gitleaks:v8.21.2 protect --staged --no-banner --redact \
  --config /repo/.gitleaks.toml --source /repo >/dev/null 2>&1 || { echo "pre-commit: 🔴 secret détecté dans les changements indexés"; exit 1; }
bash "$ROOT/harness/run-verify.sh"
bash "$ROOT/harness/run-phpunit.sh" >/dev/null || { echo "pre-commit: 🔴 tests unitaires"; exit 1; }
